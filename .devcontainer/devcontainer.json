{
  "name": "java-angular-debian",

  "image": "mcr.microsoft.com/devcontainers/base:debian-11",

  "features": {
    "ghcr.io/devcontainers/features/git:1": {},

    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "jdkDistro": "temurin"
    },

    "ghcr.io/devcontainers/features/maven:1": {
      "version": "3.9.11"
    },

    "ghcr.io/devcontainers/features/node:1": {
      "version": "18"
    },

    "ghcr.io/devcontainers/features/angular-cli:1": {}
  },

  "containerEnv": {
    "DEBIAN_FRONTEND": "noninteractive"
  },

  "onCreateCommand": "apt-get update && apt-get install -y --no-install-recommends curl unzip gnupg2 ca-certificates bash",

  "workspaceFolder": "/workspace",

  "forwardPorts": [4200, 8080, 8090],

  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "redhat.java",
        "angular.ng-template",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  },

  "remoteUser": "vscode"
}
