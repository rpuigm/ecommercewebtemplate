{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "temperature": 0.1,
      "steps": 3,
      "permission": {
        "edit": "allow",
        "bash": "deny",
        "glob": "allow",
        "grep": "allow",
        "read": "allow",
        "write": "allow",
        "doom_loop": "allow"
      }
    },
    "plan": {
      "temperature": 0.1
    }
  },
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8092/v1"
      },
      "models": {
        "qwen3-coder:a3b": {
          "name": "Qwen3-4B-Q4_K_M",
          "limit": {
            "context": 2048,
            "output": 1024
          }
        }
      }
    }
  }
}
